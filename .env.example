# Google Gemini API Key (server-side AI analysis, RAG synthesis, embeddings, and search grounding)
GEMINI_API_KEY=

# Gemini model configuration (defaults to gemini-3.8-flash and gemini-embedding-2-preview)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Python FastAPI Scraping & RAG Service configuration
PYTHON_SERVICE_PORT=8765
PYTHON_SERVICE_URL=http://127.0.0.1:8765

# Optional Government of India Open Government Data (OGD) API Key for live CPCB AQI feed
DATAGOV_API_KEY=
DATA_GOV_IN_API_KEY=
OGD_API_KEY=
